[Unit]
Description=LIVE Flow Graph AI Camera Edge Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/live-flow-edge
ExecStart=/usr/bin/python3 /opt/live-flow-edge/edge_server.py --host 0.0.0.0 --port 5000
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
